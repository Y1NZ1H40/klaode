Screen {
    background: #1a1a1e;
}

/* Welcome / login screen */

#welcome-box {
    width: auto;
    padding: 1 4;
    border: round #5a5236;
}

#logo {
    color: #d97757;
    text-align: center;
    width: auto;
}

#welcome-title {
    text-align: center;
    text-style: bold;
    margin-top: 1;
}

#login-prompt {
    margin-top: 1;
    color: #a8a29e;
}

#login-options {
    margin-top: 1;
    color: #e8e6e3;
}

#login-status {
    margin-top: 1;
    color: #7fb069;
}

/* Chat screen: plain scrolling transcript, no bubble backgrounds/borders */

#chat-log {
    padding: 1 2;
    background: transparent;
}

.message {
    height: auto;
    margin: 0 0 1 0;
}

.message-user-text {
    color: #8a8d91;
}

.message-body {
    height: auto;
    background: transparent;
}

#update-status {
    height: 1;
    padding: 0 2;
    color: #7fb069;
}

#chat-input {
    margin: 0 1;
    border: round #3a3a42;
    background: #1e1e22;
}

#chat-input:focus {
    border: round #d97757;
}

#mode-status {
    height: 1;
    padding: 0 2;
    color: #7a7873;
}
